# Django Settings
DEBUG=True
SECRET_KEY=your-django-secret-key-here
# Note the deliberate asymmetry below -- these two settings use different
# wildcard syntax. ALLOWED_HOSTS matches subdomains via a LEADING DOT; an
# asterisk is only special as the bare value "*", so "*.up.railway.app" would
# silently match nothing and every request would 400. CSRF_TRUSTED_ORIGINS does
# use the "*." form.
ALLOWED_HOSTS=127.0.0.1,localhost,.up.railway.app
CSRF_TRUSTED_ORIGINS=https://*.up.railway.app

# Clerk Credentials
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# OpenRouter Credentials
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
# Optional. Chat titles are one short throwaway call and run on their own small
# instruction-tuned model. Prefer a non-reasoning model here: a reasoning model
# spends its output budget thinking before it answers, which is wasted on a
# six-word title. Defaults to inclusionai/ling-3.0-flash:free if unset.
OPENROUTER_TITLE_MODEL=
# Optional. How many tokens of past conversation are replayed to the model each
# turn. The whole history is re-sent every time, so this is what stops a long
# chat's cost growing with the square of its length. Lower it and follow-up
# questions stop finding what they refer to; raise it and long chats cost more.
# Defaults to 4000 if unset, roughly three searched exchanges.
CHAT_HISTORY_TOKEN_BUDGET=

# Optional. The evaluator: a second model that scores each prompt and each reply
# out of ten and feeds its critiques back into later turns. Costs two extra model
# calls per message, so set this to 'false' to turn the feature off entirely.
# Defaults to on.
CHAT_EVALUATOR_ENABLED=
# Optional. Model for those critiques. They are short and highly structured, so
# prefer a small fast non-reasoning model rather than the one answering the user.
# Defaults to inclusionai/ling-3.0-flash:free if unset.
OPENROUTER_EVALUATOR_MODEL=

# Optional. Tavily API key, which powers the assistant's web search tool.
# Leave blank to run without search: the tool then reports itself unavailable
# and the assistant answers from what it already knows.
TAVILY_API=

# Polar.sh Billing
# Organization access token, from Polar dashboard -> Settings -> API Keys.
POLAR_ACCESS_TOKEN=your_polar_access_token_here
# Signing secret for the webhook endpoint, from Polar dashboard -> Webhooks.
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret_here
# 'sandbox' while testing, 'production' once live.
POLAR_SERVER=sandbox
# Product ids for each plan (Polar dashboard -> Products). Basic is $5/mo (10%
# off annually), Pro is $50/mo (10% off annually).
POLAR_PRODUCT_BASIC_MONTHLY=
POLAR_PRODUCT_BASIC_ANNUAL=
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_ANNUAL=
