# Django Settings
DEBUG=True
SECRET_KEY=your-django-secret-key-here
# Note the deliberate asymmetry below -- these two settings use different
# wildcard syntax. ALLOWED_HOSTS matches subdomains via a LEADING DOT; an
# asterisk is only special as the bare value "*", so "*.up.railway.app" would
# silently match nothing and every request would 400. CSRF_TRUSTED_ORIGINS does
# use the "*." form.
ALLOWED_HOSTS=127.0.0.1,localhost,.up.railway.app
CSRF_TRUSTED_ORIGINS=https://*.up.railway.app

# Clerk Credentials
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# OpenRouter Credentials
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
# Optional. Chat titles are one short throwaway call and run on their own small
# instruction-tuned model. Prefer a non-reasoning model here: a reasoning model
# spends its output budget thinking before it answers, which is wasted on a
# six-word title. Defaults to inclusionai/ling-3.0-flash:free if unset.
OPENROUTER_TITLE_MODEL=
